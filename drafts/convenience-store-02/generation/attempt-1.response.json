          "text": "{\n  \"questions\": [\n    {\n      \"scenario\": \"At the checkout\",\n      \"prompt\": \"You need one shopping bag. What do you say?\",\n      \"context\": \"You are paying and want the cashier to give you a bag.\",\n      \"spokenPrompt\": \"You need a bag for your purchases. How would you ask for one?\",\n      \"choices\": [\n        {\n          \"hangul\": \"봉투 하나 주세요.\",\n          \"romanization\": \"beontu hana juseyo.\"\n        },\n        {\n          \"hangul\": \"젓가락 하나 주세요.\",\n          \"romanization\": \"jjeotgarak hana juseyo.\"\n        },\n        {\n          \"hangul\": \"물 한 병 주세요.\",\n          \"romanization\": \"mul han byeong juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"One shopping bag, please.\",\n      \"explanation\": \"This politely asks for one shopping bag. 하나 means “one,” and 주세요 is a polite way to ask for something.\",\n      \"teachingPoint\": \"봉투 = bag; 하나 = one; 주세요 = please give me\",\n      \"explanationNarration\": \"This means, “One shopping bag, please.” The word for “one” comes before the item, and the ending makes it a polite request.\"\n    },\n    {\n      \"scenario\": \"With a ready meal\",\n      \"prompt\": \"You need chopsticks for your meal. What do you say?\",\n      \"context\": \"You have a ready meal but no chopsticks.\",\n      \"spokenPrompt\": \"Your meal has no chopsticks. What could you ask the staff for?\",\n      \"choices\": [\n        {\n          \"hangul\": \"젓가락 주세요.\",\n          \"romanization\": \"jjeotgarak juseyo.\"\n        },\n        {\n          \"hangul\": \"숟가락 주세요.\",\n          \"romanization\": \"sutgarak juseyo.\"\n        },\n        {\n          \"hangul\": \"냅킨 주세요.\",\n          \"romanization\": \"naepkin juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"Chopsticks, please.\",\n      \"explanation\": \"This asks for chopsticks. 숟가락 means “spoon,” while 냅킨 means “napkin”; 주세요 politely asks for the item.\",\n      \"teachingPoint\": \"젓가락 = chopsticks; 주세요 = please give me\",\n      \"explanationNarration\": \"This means, “Chopsticks, please.” You can put the item you want before a polite phrase for asking someone to give it to you.\"\n    },\n    {\n      \"scenario\": \"Heating a lunchbox\",\n      \"prompt\": \"Ask the staff to heat your lunchbox. What do you say?\",\n      \"context\": \"You bought a ready-to-eat lunchbox and want it warmed.\",\n      \"spokenPrompt\": \"You want your lunchbox warmed before you eat. How would you ask?\",\n      \"choices\": [\n        {\n          \"hangul\": \"이 도시락 데워 주세요.\",\n          \"romanization\": \"i dosirak dewo juseyo.\"\n        },\n        {\n          \"hangul\": \"이 도시락 포장해 주세요.\",\n          \"romanization\": \"i dosirak pojanghae juseyo.\"\n        },\n        {\n          \"hangul\": \"이 도시락 하나 더 주세요.\",\n          \"romanization\": \"i dosirak hana deo juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"Please heat this lunchbox.\",\n      \"explanation\": \"This asks the staff to heat the lunchbox. 데워 means “heat” here, and 주세요 turns the request into a polite one.\",\n      \"teachingPoint\": \"이 도시락 = this lunchbox; 데워 주세요 = please heat it\",\n      \"explanationNarration\": \"This means, “Please heat this lunchbox.” The verb “heat” comes before the polite request ending.\"\n    },\n    {\n      \"scenario\": \"At the register\",\n      \"prompt\": \"Ask if you can pay by card. What do you say?\",\n      \"context\": \"You are ready to pay and want to know if the store accepts cards.\",\n      \"spokenPrompt\": \"You are at the register and want to check whether card payment is possible. What would you ask?\",\n      \"choices\": [\n        {\n          \"hangul\": \"카드로 결제해도 돼요?\",\n          \"romanization\": \"kadeuro gyeoljehaedo dwaeyo?\"\n        },\n        {\n          \"hangul\": \"현금으로 결제해도 돼요?\",\n          \"romanization\": \"hyeongeumeuro gyeoljehaedo dwaeyo?\"\n        },\n        {\n          \"hangul\": \"카드로 결제할게요.\",\n          \"romanization\": \"kadeuro gyeoljehalgeyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"Can I pay by card?\",\n      \"explanation\": \"This asks whether paying by card is allowed. The question ending asks about possibility or permission; the cash option asks about a different payment method.\",\n      \"teachingPoint\": \"카드로 = by card; 결제해도 돼요? = is it okay to pay?\",\n      \"explanationNarration\": \"This means, “Can I pay by card?” The question asks whether an action is okay, rather than simply stating what you plan to do.\"\n    },\n    {\n      \"scenario\": \"Finding an item\",\n      \"prompt\": \"Ask where the ramen is. What do you say?\",\n      \"context\": \"You are in the store and cannot find the ramen on the shelves.\",\n      \"spokenPrompt\": \"You cannot spot the ramen. How would you ask where it is?\",\n      \"choices\": [\n        {\n          \"hangul\": \"라면은 어디에 있어요?\",\n          \"romanization\": \"ramyeoneun eodie isseoyo?\"\n        },\n        {\n          \"hangul\": \"과자는 어디에 있어요?\",\n          \"romanization\": \"gwajaneun eodie isseoyo?\"\n        },\n        {\n          \"hangul\": \"음료는 어디에 있어요?\",\n          \"romanization\": \"eumnyoneun eodie isseoyo?\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"Where is the ramen?\",\n      \"explanation\": \"This asks where the ramen is. 어디에 있어요? means “Where is it?”; the first word names the item you are looking for.\",\n      \"teachingPoint\": \"라면은 = as for the ramen; 어디에 있어요? = where is it?\",\n      \"explanationNarration\": \"This means, “Where is the ramen?” The question phrase means “Where is it?” Put the item you are looking for first.\"\n    }\n  ],\n  \"bonus\": {\n    \"scenario\": \"Choosing a snack size\",\n    \"prompt\": \"Ask if this snack comes in a smaller size. What do you say?\",\n    \"context\": \"The package is too large, and you want a smaller size of the same snack.\",\n    \"spokenPrompt\": \"This package is too big for you. How would you ask whether there is a smaller size?\",\n    \"choices\": [\n      {\n        \"hangul\": \"더 작은 사이즈도 있어요?\",\n        \"romanization\": \"deo jageun saijeudo isseoyo?\"\n      },\n      {\n        \"hangul\": \"더 큰 사이즈도 있어요?\",\n        \"romanization\": \"deo keun saijeudo isseoyo?\"\n      },\n      {\n        \"hangul\": \"다른 맛도 있어요?\",\n        \"romanization\": \"dareun matdo isseoyo?\"\n      }\n    ],\n    \"correctAnswerIndex\": 0,\n    \"translation\": \"Do you also have a smaller size?\",\n    \"explanation\": \"This asks whether the same snack is available in a smaller size. 더 작은 means “smaller,” and 있어요? asks whether something is available.\",\n    \"teachingPoint\": \"더 작은 = smaller; 사이즈도 있어요? = is there also a size?\"\n  }\n}"
