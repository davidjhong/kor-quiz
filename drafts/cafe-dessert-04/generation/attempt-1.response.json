          "text": "{\n  \"questions\": [\n    {\n      \"scenario\": \"At a dessert counter\",\n      \"prompt\": \"Ask the server for a menu.\",\n      \"context\": \"You want to look at the dessert list.\",\n      \"spokenPrompt\": \"How would you ask to see the menu?\",\n      \"choices\": [\n        {\n          \"hangul\": \"메뉴판 좀 주세요.\",\n          \"romanization\": \"menyupan jom juseyo.\"\n        },\n        {\n          \"hangul\": \"포크 좀 주세요.\",\n          \"romanization\": \"pokeu jom juseyo.\"\n        },\n        {\n          \"hangul\": \"케이크 좀 주세요.\",\n          \"romanization\": \"keikeu jom juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"The menu, please.\",\n      \"explanation\": \"This is a polite request for the menu. 주세요 is a useful way to ask someone to give you something.\",\n      \"teachingPoint\": \"메뉴판 = menu; 주세요 = please give me\",\n      \"explanationNarration\": \"This is a polite way to ask for the menu. The ending means you’re asking someone to give you something.\"\n    },\n    {\n      \"scenario\": \"Ordering cake\",\n      \"prompt\": \"Order one slice of cake.\",\n      \"context\": \"You want exactly one slice, not a whole cake.\",\n      \"spokenPrompt\": \"What would you ask for?\",\n      \"choices\": [\n        {\n          \"hangul\": \"케이크 한 조각 주세요.\",\n          \"romanization\": \"keikeu han jojak juseyo.\"\n        },\n        {\n          \"hangul\": \"쿠키 한 개 주세요.\",\n          \"romanization\": \"kuki han gae juseyo.\"\n        },\n        {\n          \"hangul\": \"케이크 두 조각 주세요.\",\n          \"romanization\": \"keikeu du jojak juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"One slice of cake, please.\",\n      \"explanation\": \"This asks for one slice of cake. 한 조각 means one piece or slice.\",\n      \"teachingPoint\": \"한 조각 = one slice; 주세요 = please give me\",\n      \"explanationNarration\": \"This asks for one slice of cake. The counting phrase means one piece or slice.\"\n    },\n    {\n      \"scenario\": \"Eating cake\",\n      \"prompt\": \"Ask for a fork.\",\n      \"context\": \"You need a fork to eat your cake.\",\n      \"spokenPrompt\": \"How can you politely request a fork?\",\n      \"choices\": [\n        {\n          \"hangul\": \"포크 하나 주세요.\",\n          \"romanization\": \"pokeu hana juseyo.\"\n        },\n        {\n          \"hangul\": \"숟가락 하나 주세요.\",\n          \"romanization\": \"sutgarak hana juseyo.\"\n        },\n        {\n          \"hangul\": \"냅킨 하나 주세요.\",\n          \"romanization\": \"naepkin hana juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"One fork, please.\",\n      \"explanation\": \"This politely requests one fork. 하나 means one when counting an item.\",\n      \"teachingPoint\": \"포크 = fork; 하나 = one; 주세요 = please give me\",\n      \"explanationNarration\": \"This asks for one fork. The word for one comes before the polite request.\"\n    },\n    {\n      \"scenario\": \"Sharing dessert\",\n      \"prompt\": \"Ask for one extra plate.\",\n      \"context\": \"You are sharing a cake slice and need another plate.\",\n      \"spokenPrompt\": \"What would you ask the server to bring?\",\n      \"choices\": [\n        {\n          \"hangul\": \"접시 하나 더 주세요.\",\n          \"romanization\": \"jeopsi hana deo juseyo.\"\n        },\n        {\n          \"hangul\": \"포크 하나 더 주세요.\",\n          \"romanization\": \"pokeu hana deo juseyo.\"\n        },\n        {\n          \"hangul\": \"냅킨 하나 더 주세요.\",\n          \"romanization\": \"naepkin hana deo juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"One more plate, please.\",\n      \"explanation\": \"This requests an additional plate. 하나 더 means one more.\",\n      \"teachingPoint\": \"접시 = plate; 하나 더 = one more\",\n      \"explanationNarration\": \"This asks for one additional plate. The phrase for “one more” is useful when requesting an extra item.\"\n    },\n    {\n      \"scenario\": \"Checking ingredients\",\n      \"prompt\": \"Ask whether this dessert contains nuts.\",\n      \"context\": \"You have chosen a dessert and want to check its ingredients.\",\n      \"spokenPrompt\": \"How would you check if nuts are in this dessert?\",\n      \"choices\": [\n        {\n          \"hangul\": \"이 디저트에 견과류가 들어가요?\",\n          \"romanization\": \"i dijeoteue gyeongwallyuga deureogayo?\"\n        },\n        {\n          \"hangul\": \"이 디저트에 우유가 들어가요?\",\n          \"romanization\": \"i dijeoteue uyuga deureogayo?\"\n        },\n        {\n          \"hangul\": \"이 디저트에 달걀이 들어가요?\",\n          \"romanization\": \"i dijeoteue dalgyari deureogayo?\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"Does this dessert contain nuts?\",\n      \"explanation\": \"This asks whether the dessert contains nuts. The question pattern can be used to check whether an ingredient is included.\",\n      \"teachingPoint\": \"견과류 = nuts; 들어가요? = is it included?\",\n      \"explanationNarration\": \"This asks whether the dessert contains nuts. The question pattern is useful for checking whether an ingredient is included.\"\n    }\n  ],\n  \"bonus\": {\n    \"scenario\": \"Choosing a dessert\",\n    \"prompt\": \"Ask which desserts are available without milk.\",\n    \"context\": \"You want a dessert made without milk and want to know the options.\",\n    \"spokenPrompt\": \"What could you ask to find the dessert options?\",\n    \"choices\": [\n      {\n        \"hangul\": \"우유가 안 들어간 디저트는 뭐가 있어요?\",\n        \"romanization\": \"uyuga an deureogan dijeoteuneun mwoga isseoyo?\"\n      },\n      {\n        \"hangul\": \"견과류 없는 디저트 있어요?\",\n        \"romanization\": \"gyeongwallyu eomneun dijeoteu isseoyo?\"\n      },\n      {\n        \"hangul\": \"초콜릿 디저트 있어요?\",\n        \"romanization\": \"chokollit dijeoteu isseoyo?\"\n      }\n    ],\n    \"correctAnswerIndex\": 0,\n    \"translation\": \"Which desserts are available without milk?\",\n    \"explanation\": \"This asks what desserts are available that do not contain milk. 안 들어간 describes something that is not included.\",\n    \"teachingPoint\": \"우유가 안 들어간 = without milk; 뭐가 있어요? = what options are there?\"\n  }\n}"
