      "contentId": "cafe-dessert-04-q4",
      "role": "explanation",
      "language": "en-US",
      "text": "This asks for one additional plate. The phrase for “one more” is useful when requesting an extra item.",
      "cacheKey": "97b205bee2c1442e72b54af7aafb2973d0cdddc8b7e21dde6e6c902caba6c8df",
      "file": "audio/cache/97b205bee2c1442e72b54af7aafb2973d0cdddc8b7e21dde6e6c902caba6c8df.wav",
      "durationSeconds": null
    },
    {
