    {
      "id": "cafe-dessert-04-q4-answer",
      "contentId": "cafe-dessert-04-q4",
      "role": "answer",
      "language": "ko-KR",
      "text": "접시 하나 더 주세요.",
      "cacheKey": "294ddf51b18947c7d2ba6bbd353e2669e26e4feb51da4642535b3446b605f17f",
      "file": "audio/cache/294ddf51b18947c7d2ba6bbd353e2669e26e4feb51da4642535b3446b605f17f.wav",
      "durationSeconds": null
    },
    {
