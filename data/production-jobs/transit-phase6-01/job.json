    "segments": [
      {
        "id": "public-transit-02-hook",
        "contentId": "public-transit-02",
        "role": "hook",
        "language": "en-US",
        "text": "Can you say it in Korean?"
      },
      {
        "id": "public-transit-02-q1-question",
        "contentId": "public-transit-02-q1",
        "role": "question",
        "language": "en-US",
        "text": "You’re at the station. How would you ask where to enter the subway?"
      },
      {
        "id": "public-transit-02-q1-answer",
        "contentId": "public-transit-02-q1",
        "role": "answer",
        "language": "ko-KR",
        "text": "지하철 입구가 어디예요?"
      },
      {
        "id": "public-transit-02-q1-explanation",
        "contentId": "public-transit-02-q1",
        "role": "explanation",
        "language": "en-US",
        "text": "This asks where the subway entrance is. Use this polite question pattern when you need to locate a place."
      },
      {
        "id": "public-transit-02-q2-question",
        "contentId": "public-transit-02-q2",
        "role": "question",
        "language": "en-US",
        "text": "You’re ready to board, but need directions. What would you ask?"
      },
      {
        "id": "public-transit-02-q2-answer",
        "contentId": "public-transit-02-q2",
        "role": "answer",
        "language": "ko-KR",
        "text": "승강장은 어디예요?"
      },
      {
        "id": "public-transit-02-q2-explanation",
        "contentId": "public-transit-02-q2",
        "role": "explanation",
        "language": "en-US",
        "text": "This asks where the platform is. The ending is a polite way to ask about the location of a place."
      },
      {
        "id": "public-transit-02-q3-question",
        "contentId": "public-transit-02-q3",
        "role": "question",
        "language": "en-US",
        "text": "You need a ticket before traveling. What would you ask the station worker?"
      },
      {
        "id": "public-transit-02-q3-answer",
        "contentId": "public-transit-02-q3",
        "role": "answer",
        "language": "ko-KR",
        "text": "표는 어디에서 사요?"
      },
      {
        "id": "public-transit-02-q3-explanation",
        "contentId": "public-transit-02-q3",
        "role": "explanation",
        "language": "en-US",
        "text": "This asks where you can buy a ticket. The verb here means “buy,” so it’s useful when asking where to purchase something."
      },
      {
        "id": "public-transit-02-q4-question",
        "contentId": "public-transit-02-q4",
        "role": "question",
        "language": "en-US",
        "text": "You’re not sure about the destination. How would you check where this train goes?"
      },
      {
        "id": "public-transit-02-q4-answer",
        "contentId": "public-transit-02-q4",
        "role": "answer",
        "language": "ko-KR",
        "text": "이 열차는 서울역에 가요?"
      },
      {
        "id": "public-transit-02-q4-explanation",
        "contentId": "public-transit-02-q4",
        "role": "explanation",
        "language": "en-US",
        "text": "This asks whether the train goes to Seoul Station. The particle after a place name can mark the destination."
      },
      {
        "id": "public-transit-02-q5-question",
        "contentId": "public-transit-02-q5",
        "role": "question",
        "language": "en-US",
        "text": "You need to change trains along the way. How would you ask which station to use?"
      },
      {
        "id": "public-transit-02-q5-answer",
        "contentId": "public-transit-02-q5",
        "role": "answer",
        "language": "ko-KR",
        "text": "어느 역에서 갈아타요?"
      },
      {
        "id": "public-transit-02-q5-explanation",
        "contentId": "public-transit-02-q5",
        "role": "explanation",
        "language": "en-US",
        "text": "This asks which station you should transfer at. The verb means to change from one train to another."
      },
      {
        "id": "public-transit-02-q6-question",
        "contentId": "public-transit-02-q6",
        "role": "question",
        "language": "en-US",
        "text": "You’re heading to City Hall. How would you ask which exit to take?"
      },
      {
        "id": "public-transit-02-q6-comment",
        "contentId": "public-transit-02-q6",
        "role": "comment",
        "language": "en-US",
        "text": "What do you think? Comment your answer!"
      },
      {
        "id": "public-transit-02-q6-follow",
        "contentId": "public-transit-02-q6",
        "role": "follow",
        "language": "en-US",
        "text": "Follow for more Korean!"
      }
    ]
  },
