        "id": "production-hotel-01-q1",
        "scenario": "At hotel check-in",
        "difficulty": "easy",
        "context": "You have a reservation and are speaking to the front desk on arrival.",
        "prompt": "Tell the front desk you want to begin your stay. What would you say?",
        "spokenPrompt": "What could you say to let the front desk know you’re ready to start your stay?",
        "choices": [
          {
            "hangul": "체크인하고 싶어요.",
            "romanization": "chekeuinhago sipeoyo."
          },
          {
            "hangul": "체크아웃하고 싶어요.",
            "romanization": "chekeuaut hago sipeoyo."
          },
          {
            "hangul": "엘리베이터가 어디예요?",
            "romanization": "ellibeiteoga eodiyeyo?"
          }
        ],
        "correctAnswerIndex": 0,
        "explanation": "This politely expresses that you want to check in. 싶어요 means “want to” or “would like to.”",
        "reveal": {
          "translation": "I'd like to check in.",
          "teachingPoint": "체크인하고 싶어요 = I'd like to check in. 싶어요 = would like to"
        }
      },
      {
