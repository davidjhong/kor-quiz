          "text": "{\n  \"questions\": [\n    {\n      \"scenario\": \"At hotel check-in\",\n      \"prompt\": \"Tell the front desk you want to begin your stay. What would you say?\",\n      \"context\": \"You have a reservation and are speaking to the front desk on arrival.\",\n      \"spokenPrompt\": \"What could you say to let the front desk know you’re ready to start your stay?\",\n      \"choices\": [\n        {\n          \"hangul\": \"체크인하고 싶어요.\",\n          \"romanization\": \"chekeuinhago sipeoyo.\"\n        },\n        {\n          \"hangul\": \"체크아웃하고 싶어요.\",\n          \"romanization\": \"chekeuaut hago sipeoyo.\"\n        },\n        {\n          \"hangul\": \"엘리베이터가 어디예요?\",\n          \"romanization\": \"ellibeiteoga eodiyeyo?\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"I'd like to check in.\",\n      \"explanation\": \"This politely expresses that you want to check in. 싶어요 means “want to” or “would like to.”\",\n      \"teachingPoint\": \"체크인하고 싶어요 = I'd like to check in. 싶어요 = would like to\",\n      \"explanationNarration\": \"I'd like to check in. This is a polite way to tell someone what you want to do.\"\n    },\n    {\n      \"scenario\": \"In your room\",\n      \"prompt\": \"Ask hotel staff for one additional towel.\",\n      \"context\": \"You are in your room and need one more towel.\",\n      \"spokenPrompt\": \"How would you politely ask for an extra towel?\",\n      \"choices\": [\n        {\n          \"hangul\": \"수건 하나 더 주세요.\",\n          \"romanization\": \"sugeon hana deo juseyo.\"\n        },\n        {\n          \"hangul\": \"물 하나 더 주세요.\",\n          \"romanization\": \"mul hana deo juseyo.\"\n        },\n        {\n          \"hangul\": \"담요 하나 더 주세요.\",\n          \"romanization\": \"damyo hana deo juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"One more towel, please.\",\n      \"explanation\": \"This asks politely for an additional towel. 더 means “more,” and 주세요 makes it a polite request.\",\n      \"teachingPoint\": \"수건 = towel; 하나 더 = one more; 주세요 = please give me\",\n      \"explanationNarration\": \"One more towel, please. The phrase for “one more” specifies that you need an additional towel.\"\n    },\n    {\n      \"scenario\": \"Connecting to Wi-Fi\",\n      \"prompt\": \"Ask for the Wi-Fi password.\",\n      \"context\": \"You want to connect your phone to the hotel Wi-Fi but need its password.\",\n      \"spokenPrompt\": \"What would you ask when you need the password to get online?\",\n      \"choices\": [\n        {\n          \"hangul\": \"와이파이 비밀번호가 뭐예요?\",\n          \"romanization\": \"waipai bimilbeonhoga mwoyeyo?\"\n        },\n        {\n          \"hangul\": \"조식은 몇 시예요?\",\n          \"romanization\": \"josigeun myeot siyeyo?\"\n        },\n        {\n          \"hangul\": \"엘리베이터는 어디예요?\",\n          \"romanization\": \"ellibeiteoneun eodiyeyo?\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"What is the Wi-Fi password?\",\n      \"explanation\": \"This asks for the Wi-Fi password. 뭐예요 means “what is it?” and 비밀번호 means “password.”\",\n      \"teachingPoint\": \"와이파이 비밀번호 = Wi-Fi password; 뭐예요? = What is it?\",\n      \"explanationNarration\": \"What is the Wi-Fi password? This question asks for the password, rather than the network name.\"\n    },\n    {\n      \"scenario\": \"Finding the elevator\",\n      \"prompt\": \"Ask where the elevator is.\",\n      \"context\": \"You are leaving your room and need to find the elevator.\",\n      \"spokenPrompt\": \"How would you ask someone to point you to the elevator?\",\n      \"choices\": [\n        {\n          \"hangul\": \"엘리베이터가 어디예요?\",\n          \"romanization\": \"ellibeiteoga eodiyeyo?\"\n        },\n        {\n          \"hangul\": \"식당이 어디예요?\",\n          \"romanization\": \"sigdangi eodiyeyo?\"\n        },\n        {\n          \"hangul\": \"방이 몇 층이에요?\",\n          \"romanization\": \"bangi myeot cheungieyo?\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"Where is the elevator?\",\n      \"explanation\": \"This asks for the elevator's location. 어디예요 means “where is it?”\",\n      \"teachingPoint\": \"엘리베이터 = elevator; 어디예요? = Where is it?\",\n      \"explanationNarration\": \"Where is the elevator? The question ending turns a location phrase into a polite question.\"\n    },\n    {\n      \"scenario\": \"A key card problem\",\n      \"prompt\": \"Tell the front desk your key card won't open the door and ask for help.\",\n      \"context\": \"Your room door will not unlock with your key card.\",\n      \"spokenPrompt\": \"What could you say to report the card problem and ask staff to check it?\",\n      \"choices\": [\n        {\n          \"hangul\": \"카드키가 안 돼요. 확인해 주세요.\",\n          \"romanization\": \"kadeukiga an dwaeyo. hwaginhae juseyo.\"\n        },\n        {\n          \"hangul\": \"카드키를 잃어버렸어요.\",\n          \"romanization\": \"kadeukireul ireobeoryeosseoyo.\"\n        },\n        {\n          \"hangul\": \"수건을 더 주세요.\",\n          \"romanization\": \"sugeoneul deo juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"The key card doesn't work. Please check it.\",\n      \"explanation\": \"This reports that the key card is not working and politely asks staff to check it. 확인해 주세요 means “please check.”\",\n      \"teachingPoint\": \"안 돼요 = doesn't work; 확인해 주세요 = please check\",\n      \"explanationNarration\": \"The key card doesn't work. Please check it. This combines a polite problem report with a request for help.\"\n    }\n  ],\n  \"bonus\": {\n    \"scenario\": \"After checkout\",\n    \"prompt\": \"Ask whether you may leave your luggage at the hotel after checking out.\",\n    \"context\": \"You have checked out and want to ask the front desk about leaving your luggage.\",\n    \"spokenPrompt\": \"How would you ask the front desk if you may leave your bags the