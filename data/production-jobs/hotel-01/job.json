    "segments": [
      {
        "id": "production-hotel-01-hook",
        "contentId": "production-hotel-01",
        "role": "hook",
        "language": "en-US",
        "text": "Can you say it in Korean?"
      },
      {
        "id": "production-hotel-01-q1-question",
        "contentId": "production-hotel-01-q1",
        "role": "question",
        "language": "en-US",
        "text": "What could you say to let the front desk know you’re ready to start your stay?"
      },
      {
        "id": "production-hotel-01-q1-answer",
        "contentId": "production-hotel-01-q1",
        "role": "answer",
        "language": "ko-KR",
        "text": "체크인하고 싶어요."
      },
      {
        "id": "production-hotel-01-q1-explanation",
        "contentId": "production-hotel-01-q1",
        "role": "explanation",
        "language": "en-US",
        "text": "I'd like to check in. This is a polite way to tell someone what you want to do."
      },
      {
        "id": "production-hotel-01-q2-question",
        "contentId": "production-hotel-01-q2",
        "role": "question",
        "language": "en-US",
        "text": "How would you politely ask for an extra towel?"
      },
      {
        "id": "production-hotel-01-q2-answer",
        "contentId": "production-hotel-01-q2",
        "role": "answer",
        "language": "ko-KR",
        "text": "수건 하나 더 주세요."
      },
      {
        "id": "production-hotel-01-q2-explanation",
        "contentId": "production-hotel-01-q2",
        "role": "explanation",
        "language": "en-US",
        "text": "One more towel, please. The phrase for “one more” specifies that you need an additional towel."
      },
      {
        "id": "production-hotel-01-q3-question",
        "contentId": "production-hotel-01-q3",
        "role": "question",
        "language": "en-US",
        "text": "What would you ask when you need the password to get online?"
      },
      {
        "id": "production-hotel-01-q3-answer",
        "contentId": "production-hotel-01-q3",
        "role": "answer",
        "language": "ko-KR",
        "text": "와이파이 비밀번호가 뭐예요?"
      },
      {
        "id": "production-hotel-01-q3-explanation",
        "contentId": "production-hotel-01-q3",
        "role": "explanation",
        "language": "en-US",
        "text": "What is the Wi-Fi password? This question asks for the password, rather than the network name."
      },
      {
        "id": "production-hotel-01-q4-question",
        "contentId": "production-hotel-01-q4",
        "role": "question",
        "language": "en-US",
        "text": "How would you ask someone to point you to the elevator?"
      },
      {
        "id": "production-hotel-01-q4-answer",
        "contentId": "production-hotel-01-q4",
        "role": "answer",
        "language": "ko-KR",
        "text": "엘리베이터가 어디예요?"
      },
      {
        "id": "production-hotel-01-q4-explanation",
        "contentId": "production-hotel-01-q4",
        "role": "explanation",
        "language": "en-US",
        "text": "Where is the elevator? The question ending turns a location phrase into a polite question."
      },
      {
        "id": "production-hotel-01-q5-question",
        "contentId": "production-hotel-01-q5",
        "role": "question",
        "language": "en-US",
        "text": "What could you say to report the card problem and ask staff to check it?"
      },
      {
        "id": "production-hotel-01-q5-answer",
        "contentId": "production-hotel-01-q5",
        "role": "answer",
        "language": "ko-KR",
        "text": "카드키가 안 돼요. 확인해 주세요."
      },
      {
        "id": "production-hotel-01-q5-explanation",
        "contentId": "production-hotel-01-q5",
        "role": "explanation",
        "language": "en-US",
        "text": "The key card doesn't work. Please check it. This combines a polite problem report with a request for help."
      },
      {
        "id": "production-hotel-01-q6-question",
        "contentId": "production-hotel-01-q6",
        "role": "question",
        "language": "en-US",
        "text": "How would you ask the front desk if you may leave your bags there after checkout?"
      },
      {
        "id": "production-hotel-01-q6-comment",
        "contentId": "production-hotel-01-q6",
        "role": "comment",
        "language": "en-US",
        "text": "What do you think? Comment your answer!"
      },
      {
        "id": "production-hotel-01-q6-follow",
        "contentId": "production-hotel-01-q6",
        "role": "follow",
        "language": "en-US",
        "text": "Follow for more Korean!"
      }
    ]
