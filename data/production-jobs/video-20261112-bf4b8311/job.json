    "segments": [
      {
        "id": "production-video-20261112-bf4b8311-hook",
        "contentId": "production-video-20261112-bf4b8311",
        "role": "hook",
        "language": "en-US",
        "text": "Can you say it in Korean?"
      },
      {
        "id": "production-video-20261112-bf4b8311-q1-question",
        "contentId": "production-video-20261112-bf4b8311-q1",
        "role": "question",
        "language": "en-US",
        "text": "You’re looking for potato chips. What could you ask the clerk?"
      },
      {
        "id": "production-video-20261112-bf4b8311-q1-answer",
        "contentId": "production-video-20261112-bf4b8311-q1",
        "role": "answer",
        "language": "ko-KR",
        "text": "감자칩은 어디에 있어요?"
      },
      {
        "id": "production-video-20261112-bf4b8311-q1-explanation",
        "contentId": "production-video-20261112-bf4b8311-q1",
        "role": "explanation",
        "language": "en-US",
        "text": "It asks where potato chips are; use it to locate an item."
      },
      {
        "id": "production-video-20261112-bf4b8311-q2-question",
        "contentId": "production-video-20261112-bf4b8311-q2",
        "role": "question",
        "language": "en-US",
        "text": "You have a snack in hand. How can you ask its price?"
      },
      {
        "id": "production-video-20261112-bf4b8311-q2-answer",
        "contentId": "production-video-20261112-bf4b8311-q2",
        "role": "answer",
        "language": "ko-KR",
        "text": "이 과자는 얼마예요?"
      },
      {
        "id": "production-video-20261112-bf4b8311-q2-explanation",
        "contentId": "production-video-20261112-bf4b8311-q2",
        "role": "explanation",
        "language": "en-US",
        "text": "It asks the snack’s price; use this polite question when buying."
      },
      {
        "id": "production-video-20261112-bf4b8311-q3-question",
        "contentId": "production-video-20261112-bf4b8311-q3",
        "role": "question",
        "language": "en-US",
        "text": "You’ve picked your items and need one bag. What do you say?"
      },
      {
        "id": "production-video-20261112-bf4b8311-q3-answer",
        "contentId": "production-video-20261112-bf4b8311-q3",
        "role": "answer",
        "language": "ko-KR",
        "text": "봉투 하나 주세요."
      },
      {
        "id": "production-video-20261112-bf4b8311-q3-explanation",
        "contentId": "production-video-20261112-bf4b8311-q3",
        "role": "explanation",
        "language": "en-US",
        "text": "It requests one bag; the number word makes the quantity clear."
      },
      {
        "id": "production-video-20261112-bf4b8311-q4-question",
        "contentId": "production-video-20261112-bf4b8311-q4",
        "role": "question",
        "language": "en-US",
        "text": "The cashier is ready. How will you say you’re using your bank card?"
      },
      {
        "id": "production-video-20261112-bf4b8311-q4-answer",
        "contentId": "production-video-20261112-bf4b8311-q4",
        "role": "answer",
        "language": "ko-KR",
        "text": "카드로 결제할게요."
      },
      {
        "id": "production-video-20261112-bf4b8311-q4-explanation",
        "contentId": "production-video-20261112-bf4b8311-q4",
        "role": "explanation",
        "language": "en-US",
        "text": "You’ll pay by card; the ending politely states your intention."
      },
      {
        "id": "production-video-20261112-bf4b8311-q5-question",
        "contentId": "production-video-20261112-bf4b8311-q5",
        "role": "question",
        "language": "en-US",
        "text": "Before choosing it, how can you check whether the snack is spicy?"
      },
      {
        "id": "production-video-20261112-bf4b8311-q5-answer",
        "contentId": "production-video-20261112-bf4b8311-q5",
        "role": "answer",
        "language": "ko-KR",
        "text": "이 과자 매워요?"
      },
      {
        "id": "production-video-20261112-bf4b8311-q5-explanation",
        "contentId": "production-video-20261112-bf4b8311-q5",
        "role": "explanation",
        "language": "en-US",
        "text": "It asks whether the snack is spicy; this checks its flavor."
      },
      {
        "id": "production-video-20261112-bf4b8311-q6-question",
        "contentId": "production-video-20261112-bf4b8311-q6",
        "role": "question",
        "language": "en-US",
        "text": "You want a mild snack. How would you ask the clerk for a suggestion?"
      },
      {
        "id": "production-video-20261112-bf4b8311-q6-comment",
        "contentId": "production-video-20261112-bf4b8311-q6",
        "role": "comment",
        "language": "en-US",
        "text": "What do you think? Comment your answer!"
      },
      {
        "id": "production-video-20261112-bf4b8311-q6-follow",
        "contentId": "production-video-20261112-bf4b8311-q6",
        "role": "follow",
        "language": "en-US",
        "text": "Follow for more Korean!"
      }
    ]
  },
