      "role": "explanation",
      "language": "en-US",
      "text": "It asks where potato chips are; use it to locate an item.",
      "cacheKey": "b6ede010ec4b38f17532e39b553477f8e1cea61a1030d0f0d35a91a5e158f9a1",
