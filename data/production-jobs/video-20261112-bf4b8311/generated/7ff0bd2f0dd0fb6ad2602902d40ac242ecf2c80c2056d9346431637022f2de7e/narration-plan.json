      "role": "answer",
      "language": "ko-KR",
      "text": "이 과자는 얼마예요?",
      "cacheKey": "eba82bb7278f2308052b7f12fbe97751c13da24745ea2b0bb622e84d7b089105",
      "file": "audio/cache/eba82bb7278f2308052b7f12fbe97751c13da24745ea2b0bb622e84d7b089105.wav",
