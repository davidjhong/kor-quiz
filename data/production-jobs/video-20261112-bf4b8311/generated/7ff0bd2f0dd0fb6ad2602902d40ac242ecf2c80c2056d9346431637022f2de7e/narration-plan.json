      "role": "question",
      "language": "en-US",
      "text": "You’re looking for potato chips. What could you ask the clerk?",
      "cacheKey": "bbbe3bf47646afa9bd4791c5655919932c76f0d671006372e459121838bba886",
      "file": "audio/cache/bbbe3bf47646afa9bd4791c5655919932c76f0d671006372e459121838bba886.wav",
