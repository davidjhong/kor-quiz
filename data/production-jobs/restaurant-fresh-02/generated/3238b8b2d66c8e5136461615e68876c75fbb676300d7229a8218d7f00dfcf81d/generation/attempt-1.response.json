          "text": "{\n  \"questions\": [\n    {\n      \"scenario\": \"Choosing a dinner dish\",\n      \"prompt\": \"Choose bibimbap from the menu. What would you say?\",\n      \"context\": \"You have decided to order bibimbap for dinner.\",\n      \"spokenPrompt\": \"You’ve chosen bibimbap for dinner. How would you order it?\",\n      \"choices\": [\n        {\n          \"hangul\": \"비빔밥 주세요.\",\n          \"romanization\": \"bibimbap juseyo.\"\n        },\n        {\n          \"hangul\": \"불고기 주세요.\",\n          \"romanization\": \"bulgogi juseyo.\"\n        },\n        {\n          \"hangul\": \"김치찌개 주세요.\",\n          \"romanization\": \"gimchi-jjigae juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"Bibimbap, please.\",\n      \"explanation\": \"This politely asks for bibimbap. The dish name comes before the request ending.\",\n      \"teachingPoint\": \"비빔밥 = bibimbap; 주세요 = please give me\",\n      \"explanationNarration\": \"Bibimbap, please. Put the dish you want before the polite phrase used to ask for something.\"\n    },\n    {\n      \"scenario\": \"Ordering a drink\",\n      \"prompt\": \"Order one cup of barley tea. What would you say?\",\n      \"context\": \"You want one cup of barley tea with dinner.\",\n      \"spokenPrompt\": \"You’d like a cup of barley tea with your meal. How do you order it?\",\n      \"choices\": [\n        {\n          \"hangul\": \"보리차 한 잔 주세요.\",\n          \"romanization\": \"bori-cha han jan juseyo.\"\n        },\n        {\n          \"hangul\": \"물 한 잔 주세요.\",\n          \"romanization\": \"mul han jan juseyo.\"\n        },\n        {\n          \"hangul\": \"주스 한 잔 주세요.\",\n          \"romanization\": \"juseu han jan juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"One cup of barley tea, please.\",\n      \"explanation\": \"This requests one cup of barley tea. The counter phrase 한 잔 is used for a cup or glass of a drink.\",\n      \"teachingPoint\": \"한 잔 = one cup/glass; 보리차 = barley tea\",\n      \"explanationNarration\": \"One cup of barley tea, please. The phrase for one cup or glass comes after the drink name.\"\n    },\n    {\n      \"scenario\": \"Adjusting the spice level\",\n      \"prompt\": \"Ask for your dish to be less spicy. What would you say?\",\n      \"context\": \"The kitchen can make your dish less spicy.\",\n      \"spokenPrompt\": \"You enjoy the dish, but want less heat. How would you ask?\",\n      \"choices\": [\n        {\n          \"hangul\": \"덜 맵게 해 주세요.\",\n          \"romanization\": \"deol maepge hae juseyo.\"\n        },\n        {\n          \"hangul\": \"더 맵게 해 주세요.\",\n          \"romanization\": \"deo maepge hae juseyo.\"\n        },\n        {\n          \"hangul\": \"덜 짜게 해 주세요.\",\n          \"romanization\": \"deol jjage hae juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"Please make it less spicy.\",\n      \"explanation\": \"This asks the kitchen to reduce the spice. 덜 means less, while 더 means more.\",\n      \"teachingPoint\": \"덜 맵게 = less spicy; 해 주세요 = please make/do\",\n      \"explanationNarration\": \"Please make it less spicy. The word for less can also be used with other descriptions, such as salty.\"\n    },\n    {\n      \"scenario\": \"Requesting no onion\",\n      \"prompt\": \"Ask for the onions to be left out. What would you say?\",\n      \"context\": \"Your dish includes onions, and you do not want any.\",\n      \"spokenPrompt\": \"Your meal comes with onions, but you’d prefer none. What would you ask?\",\n      \"choices\": [\n        {\n          \"hangul\": \"양파 빼 주세요.\",\n          \"romanization\": \"yangpa ppae juseyo.\"\n        },\n        {\n          \"hangul\": \"마늘 빼 주세요.\",\n          \"romanization\": \"maneul ppae juseyo.\"\n        },\n        {\n          \"hangul\": \"고추 빼 주세요.\",\n          \"romanization\": \"gochu ppae juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"Please leave out the onions.\",\n      \"explanation\": \"This asks for onions to be omitted. The verb 빼다 means to leave something out or remove it.\",\n      \"teachingPoint\": \"양파 = onion; 빼 주세요 = please leave out\",\n      \"explanationNarration\": \"Please leave out the onions. The verb in this request means to remove something or leave it out.\"\n    },\n    {\n      \"scenario\": \"Asking for the bill\",\n      \"prompt\": \"You are ready to pay. Ask for the bill.\",\n      \"context\": \"You have finished dinner and have not paid yet.\",\n      \"spokenPrompt\": \"You’ve finished eating and are ready to settle up. What would you ask for?\",\n      \"choices\": [\n        {\n          \"hangul\": \"계산서 주세요.\",\n          \"romanization\": \"gyesanseo juseyo.\"\n        },\n        {\n          \"hangul\": \"메뉴판 주세요.\",\n          \"romanization\": \"menyupan juseyo.\"\n        },\n        {\n          \"hangul\": \"물 좀 주세요.\",\n          \"romanization\": \"mul jom juseyo.\"\n        }\n      ],\n      \"correctAnswerIndex\": 0,\n      \"translation\": \"The bill, please.\",\n      \"explanation\": \"This asks for the bill before payment. 주세요 makes the request polite.\",\n      \"teachingPoint\": \"계산서 = bill; 주세요 = please give me\",\n      \"explanationNarration\": \"The bill, please. The first word means bill, and the ending turns it into a polite request.\"\n    }\n  ],\n  \"bonus\": {\n    \"scenario\": \"Splitting the bill\",\n    \"prompt\": \"You and your friend will pay separately. What would you say?\",\n    \"context\": \"You are dining together, and each person will pay for their own meal.\",\n    \"spokenPrompt\": \"You and your friend are paying for your own meals. How would you ask to handle the bill?\",\n    \"choices\": [\n      {\n        \"hangul\": \"따로 계산해 주세요.\",\n        \"romanization\": \"ttaro gyesanhae juseyo.\"\n      },\n      {\n        \"hangul\": \"한 번에 계산해 주세요.\",\n        \"romanization\": \"han beone gyesanhae juseyo.\"\n      },\n      {\n        \"hangul\": \"카드로 계산해 주세요.\",\n        \"romanization\": \"kadeuro gyesanhae juseyo.\"\n      }\n    ],\n    \"correctAnswerIndex\": 0,\n    \"translation\": \"Please let us pay separately.\",\n    \"explanation\": \"This requests separate payment. 따로 means separately, and 계산해 주세요 is a polite request to handle the payment.\",\n    \"teachingPoint\": \"따로 = separately; 계산해 주세요 = please handle the payment\"\n  },\n  \"derivedBrief\": {\n    \"context\": \"An English-speaking beginner is ordering dinner at a restaurant, making simple choices and polite requests, then paying.\",\n    \"learningObjectives\": [\n      \"Order a chosen dinner dish politely.\",\n      \"Request one cup of a specific drink.\",\n      \"Ask for a dish to be made less spicy.\",\n      \"Ask for a particular ingredient to be left out.\",\n      \"Request the bill after finishing dinner.\",\n      \"Ask to pay separately when dining with a friend.\"\n    ]\n  }\n}"
