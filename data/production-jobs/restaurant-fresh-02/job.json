    "segments": [
      {
        "id": "production-restaurant-fresh-02-hook",
        "contentId": "production-restaurant-fresh-02",
        "role": "hook",
        "language": "en-US",
        "text": "Can you say it in Korean?"
      },
      {
        "id": "production-restaurant-fresh-02-q1-question",
        "contentId": "production-restaurant-fresh-02-q1",
        "role": "question",
        "language": "en-US",
        "text": "You’ve chosen bibimbap for dinner. How would you order it?"
      },
      {
        "id": "production-restaurant-fresh-02-q1-answer",
        "contentId": "production-restaurant-fresh-02-q1",
        "role": "answer",
        "language": "ko-KR",
        "text": "비빔밥 주세요."
      },
      {
        "id": "production-restaurant-fresh-02-q1-explanation",
        "contentId": "production-restaurant-fresh-02-q1",
        "role": "explanation",
        "language": "en-US",
        "text": "Bibimbap, please. Put the dish you want before the polite phrase used to ask for something."
      },
      {
        "id": "production-restaurant-fresh-02-q2-question",
        "contentId": "production-restaurant-fresh-02-q2",
        "role": "question",
        "language": "en-US",
        "text": "You’d like a cup of barley tea with your meal. How do you order it?"
      },
      {
        "id": "production-restaurant-fresh-02-q2-answer",
        "contentId": "production-restaurant-fresh-02-q2",
        "role": "answer",
        "language": "ko-KR",
        "text": "보리차 한 잔 주세요."
      },
      {
        "id": "production-restaurant-fresh-02-q2-explanation",
        "contentId": "production-restaurant-fresh-02-q2",
        "role": "explanation",
        "language": "en-US",
        "text": "One cup of barley tea, please. The phrase for one cup or glass comes after the drink name."
      },
      {
        "id": "production-restaurant-fresh-02-q3-question",
        "contentId": "production-restaurant-fresh-02-q3",
        "role": "question",
        "language": "en-US",
        "text": "You enjoy the dish, but want less heat. How would you ask?"
      },
      {
        "id": "production-restaurant-fresh-02-q3-answer",
        "contentId": "production-restaurant-fresh-02-q3",
        "role": "answer",
        "language": "ko-KR",
        "text": "덜 맵게 해 주세요."
      },
      {
        "id": "production-restaurant-fresh-02-q3-explanation",
        "contentId": "production-restaurant-fresh-02-q3",
        "role": "explanation",
        "language": "en-US",
        "text": "Please make it less spicy. The word for less can also be used with other descriptions, such as salty."
      },
      {
        "id": "production-restaurant-fresh-02-q4-question",
        "contentId": "production-restaurant-fresh-02-q4",
        "role": "question",
        "language": "en-US",
        "text": "Your meal comes with onions, but you’d prefer none. What would you ask?"
      },
      {
        "id": "production-restaurant-fresh-02-q4-answer",
        "contentId": "production-restaurant-fresh-02-q4",
        "role": "answer",
        "language": "ko-KR",
        "text": "양파 빼 주세요."
      },
      {
        "id": "production-restaurant-fresh-02-q4-explanation",
        "contentId": "production-restaurant-fresh-02-q4",
        "role": "explanation",
        "language": "en-US",
        "text": "Please leave out the onions. The verb in this request means to remove something or leave it out."
      },
      {
        "id": "production-restaurant-fresh-02-q5-question",
        "contentId": "production-restaurant-fresh-02-q5",
        "role": "question",
        "language": "en-US",
        "text": "You’ve finished eating and are ready to settle up. What would you ask for?"
      },
      {
        "id": "production-restaurant-fresh-02-q5-answer",
        "contentId": "production-restaurant-fresh-02-q5",
        "role": "answer",
        "language": "ko-KR",
        "text": "계산서 주세요."
      },
      {
        "id": "production-restaurant-fresh-02-q5-explanation",
        "contentId": "production-restaurant-fresh-02-q5",
        "role": "explanation",
        "language": "en-US",
        "text": "The bill, please. The first word means bill, and the ending turns it into a polite request."
      },
      {
        "id": "production-restaurant-fresh-02-q6-question",
        "contentId": "production-restaurant-fresh-02-q6",
        "role": "question",
        "language": "en-US",
        "text": "You and your friend are paying for your own meals. How would you ask to handle the bill?"
      },
      {
        "id": "production-restaurant-fresh-02-q6-comment",
        "contentId": "production-restaurant-fresh-02-q6",
        "role": "comment",
        "language": "en-US",
        "text": "What do you think? Comment your answer!"
      },
      {
        "id": "production-restaurant-fresh-02-q6-follow",
        "contentId": "production-restaurant-fresh-02-q6",
        "role": "follow",
        "language": "en-US",
        "text": "Follow for more Korean!"
      }
    ]
